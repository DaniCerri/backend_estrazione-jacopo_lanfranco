# Railway: DATABASE_URL arriva dal plugin Postgres (${{Postgres.DATABASE_URL}})
DATABASE_URL=sqlite:///./dev.db

# Minimo 10 caratteri. Usata per entrare in /admin
ADMIN_PASSWORD=cambia-questa-password
# Minimo 32 caratteri: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Codice opaco nel QR -> zona. Genera: uv run python -m app.manage genera-codici
ZONE_CODES={"dev-normale":"normale","dev-premium":"premium","dev-vip":"vip"}

# false solo in sviluppo locale su http
COOKIE_SECURE=true
# Data/versione dei testi legali accettati, salvata con ogni iscrizione
INFORMATIVA_VERSIONE=2026-10-11
DEBUG=false
